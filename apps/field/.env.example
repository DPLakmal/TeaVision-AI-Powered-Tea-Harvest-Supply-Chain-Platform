# TeaVision Field App Environment Variables
# In Expo, variables prefixed with EXPO_PUBLIC_ are exposed to the client bundle

# Go REST API URL (use your computer's LAN IP when running on physical device, e.g. http://192.168.1.100:8080)
EXPO_PUBLIC_API_URL=http://localhost:8080

# ML Inference Service URL (e.g. http://192.168.1.100:8000)
EXPO_PUBLIC_ML_URL=http://localhost:8000
