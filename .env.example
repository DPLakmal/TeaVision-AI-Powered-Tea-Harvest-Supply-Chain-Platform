# Environment variables — copy to .env and fill in secrets
# Never commit .env to version control

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=teavision
POSTGRES_USER=teavision
POSTGRES_PASSWORD=changeme_strong_password

# ─── Go API ───────────────────────────────────────────────
DATABASE_URL=postgres://teavision:changeme_strong_password@postgres:5432/teavision?sslmode=disable
JWT_SECRET=changeme_jwt_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
API_PORT=8080
API_ENV=development
LOG_LEVEL=debug

# ─── ML Service ───────────────────────────────────────────
ML_PORT=8000
MODEL_ARCH=mobilenetv3
MODEL_PATH=/app/models/tea_grader.pt
MODEL_VERSION=v1.0.0
ML_ENV=development

# ─── Next.js Dashboard ────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme_nextauth_secret
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ML_URL=http://localhost:8000

# ─── AWS (Production only) ────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=teavision-leaf-images
AWS_ACCOUNT_ID=123456789012

# ─── Weights & Biases (Optional, for ML training) ─────────
WANDB_API_KEY=
WANDB_PROJECT=teavision-tea-grader
